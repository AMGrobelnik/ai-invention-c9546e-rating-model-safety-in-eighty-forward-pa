\newlabel{sec:unit}{{5.5}{21}{The aggregation unit, and a negative that is robust to its own thresholds}{subsection.5.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Every score against the judged plain-harmful refusal rate at \textbf  {both} aggregation units. Rows 1--5 are the 19-member / 7-lineage panel with the exhaustive $7!$ permutation null in both units; rows 6--10 are the 52-member / 28-lineage scale panel with a Monte-Carlo null over 200,000 draws. The logit-gap harmful margin is the only score that excludes zero at both units on both panels.}}{22}{table.5}\protected@file@percent }
\newlabel{tab:units}{{5}{22}{Every score against the judged plain-harmful refusal rate at \textbf {both} aggregation units. Rows 1--5 are the 19-member / 7-lineage panel with the exhaustive $7!$ permutation null in both units; rows 6--10 are the 52-member / 28-lineage scale panel with a Monte-Carlo null over 200,000 draws. The logit-gap harmful margin is the only score that excludes zero at both units on both panels}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces The discrimination matrix: four cheap benchmark-free safety scores $\times $ five falsification checks (C1 lexical, C2 monotone, C3 depth, C4 jackknife, C5 scorer; P = PASS, F = FAIL), on the frozen 19-member / 7-lineage panel, all correlations at the \textbf  {member level} with the lineage as the resampling and permutation unit (exhaustive $7! = 5040$; achievable floor $1.98\times 10^{-4}$). Verdict: \texttt  {PROTOCOL\_DOES\_NOT\_DISCRIMINATE}. Check 5 is a property of the shared scorer (REFUSAL $\kappa = 0.391$ against a $0.60$ threshold), so it fails identically in every row and caps every row at 4/5.}}{22}{table.6}\protected@file@percent }
\newlabel{tab:matrix}{{6}{22}{The discrimination matrix: four cheap benchmark-free safety scores $\times $ five falsification checks (C1 lexical, C2 monotone, C3 depth, C4 jackknife, C5 scorer; P = PASS, F = FAIL), on the frozen 19-member / 7-lineage panel, all correlations at the \textbf {member level} with the lineage as the resampling and permutation unit (exhaustive $7! = 5040$; achievable floor $1.98\times 10^{-4}$). Verdict: \texttt {PROTOCOL\_DOES\_NOT\_DISCRIMINATE}. Check 5 is a property of the shared scorer (REFUSAL $\kappa = 0.391$ against a $0.60$ threshold), so it fails identically in every row and caps every row at 4/5}{table.6}{}}
